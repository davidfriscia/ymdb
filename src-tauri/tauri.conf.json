{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Your MAME DB",
  "mainBinaryName": "ymdb",
  "version": "../package.json",
  "identifier": "io.github.davidfriscia.ymdb",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YMDB — Your MAME DB",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Your MAME DB",
    "longDescription": "Your MAME DB (YMDB) is a cross-platform desktop frontend for MAME.",
    "category": "Game",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
