# Normalize line endings to LF in the repository
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated lockfiles
pnpm-lock.yaml linguist-generated=true -diff
src-tauri/Cargo.lock linguist-generated=true -diff
